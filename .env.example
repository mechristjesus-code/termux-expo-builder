# Only put non-secret values prefixed with EXPO_PUBLIC_ here.
# Never commit EXPO_TOKEN or private API keys.
EXPO_PUBLIC_APP_ENV=development

# Local GGUF / llama.cpp OpenAI-compatible endpoint.
EXPO_PUBLIC_AI_BASE_URL=http://127.0.0.1:8080

# n8n webhook used by the in-app build controls.
EXPO_PUBLIC_N8N_BUILD_WEBHOOK_URL=
